---
import { Image } from 'astro:assets';
import heroImg from '../assets/screenshots/01-profiles-empty.png';
---

<section class="hero">
  <div class="hero__dots" aria-hidden="true"></div>
  <div class="hero__glow" aria-hidden="true"></div>

  <div class="hero__inner">
    <div class="hero__content">
      <div class="hero__badge">
        <span class="hero__badge-dot"></span>
        GTK4 &middot; D-Bus Integration &middot; Open Source
      </div>

      <h1 class="hero__title">
        OpenVPN 3<br />
        <span class="hero__title-accent">Linux Client</span>
      </h1>

      <p class="hero__tagline">
        A native GTK4 GUI and companion CLI for OpenVPN 3 Linux —
        full D-Bus integration, no vendor lock-in.
      </p>

      <div class="hero__terminal">
        <div class="hero__terminal-bar">
          <span class="hero__dot" style="background:#FF5F56"></span>
          <span class="hero__dot" style="background:#FFBD2E"></span>
          <span class="hero__dot" style="background:#27C93F"></span>
          <span class="hero__terminal-file">install.sh</span>
        </div>
        <div class="hero__terminal-body">
          <span class="hero__prompt">$</span>
          <code id="install-cmd">curl -fsSL https://raw.githubusercontent.com/hassan-mehedi/openvpn-linux-client-gui/main/install.sh | bash</code>
          <button id="copy-btn" class="hero__copy" aria-label="Copy install command">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
            </svg>
            <span id="copy-label">Copy</span>
          </button>
        </div>
      </div>

      <div class="hero__actions">
        <a href="https://github.com/hassan-mehedi/openvpn-linux-client-gui/releases" class="btn btn--primary">
          Download
        </a>
        <a href="/docs/getting-started/requirements/" class="btn btn--secondary">
          Documentation
        </a>
        <a href="https://github.com/hassan-mehedi/openvpn-linux-client-gui" class="btn btn--ghost" target="_blank" rel="noopener">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
          </svg>
          GitHub
        </a>
      </div>
    </div>

    <div class="hero__visual" aria-hidden="true">
      <div class="hero__screenshot-halo"></div>
      <Image
        src={heroImg}
        alt="OpenVPN 3 Linux Client – Profiles view"
        width={360}
        quality={90}
        class="hero__screenshot"
      />
    </div>
  </div>
</section>

<script>
  const btn = document.getElementById('copy-btn') as HTMLButtonElement | null;
  const cmd = document.getElementById('install-cmd');
  const label = document.getElementById('copy-label');
  btn?.addEventListener('click', () => {
    navigator.clipboard.writeText(cmd?.textContent ?? '');
    if (label) label.textContent = 'Copied!';
    if (btn) btn.classList.add('hero__copy--done');
    setTimeout(() => {
      if (label) label.textContent = 'Copy';
      if (btn) btn.classList.remove('hero__copy--done');
    }, 2000);
  });
</script>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding: 6rem 2rem 5.5rem;
    border-bottom: 1px solid var(--border);
  }

  /* Subtle dot-grid background */
  .hero__dots {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle at 1px 1px, rgba(255,255,255,0.045) 1px, transparent 0);
    background-size: 28px 28px;
    pointer-events: none;
  }

  /* Ambient orange glow behind content */
  .hero__glow {
    position: absolute;
    top: -100px;
    left: -100px;
    width: 600px;
    height: 600px;
    background: radial-gradient(ellipse at center, rgba(240, 130, 32, 0.07) 0%, transparent 65%);
    pointer-events: none;
  }

  .hero__inner {
    position: relative;
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 4rem;
  }

  .hero__content {
    flex: 1;
    max-width: 560px;
  }

  /* Pill badge */
  .hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(240, 130, 32, 0.09);
    border: 1px solid rgba(240, 130, 32, 0.22);
    color: var(--accent-bright);
    font-size: 0.72rem;
    font-weight: 500;
    padding: 0.3rem 0.75rem;
    border-radius: 100px;
    margin-bottom: 1.5rem;
    letter-spacing: 0.02em;
    font-family: var(--font-mono);
  }
  .hero__badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--green);
    flex-shrink: 0;
    animation: blink 2.4s ease-in-out infinite;
  }
  @keyframes blink {
    0%, 100% { opacity: 1; }
    50%       { opacity: 0.35; }
  }

  /* Title */
  .hero__title {
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 5.5vw, 4.25rem);
    font-weight: 800;
    line-height: 1.04;
    letter-spacing: -0.035em;
    color: var(--text);
    margin: 0 0 1.25rem;
  }
  .hero__title-accent {
    color: var(--accent);
  }

  /* Tagline */
  .hero__tagline {
    font-size: 1.05rem;
    line-height: 1.72;
    color: var(--text-2);
    margin: 0 0 2rem;
    max-width: 460px;
  }

  /* Terminal block */
  .hero__terminal {
    background: #040D18;
    border: 1px solid var(--border);
    border-radius: 10px;
    margin-bottom: 1.75rem;
    overflow: hidden;
  }
  .hero__terminal-bar {
    display: flex;
    align-items: center;
    gap: 5px;
    padding: 0.55rem 0.875rem;
    background: rgba(255,255,255,0.025);
    border-bottom: 1px solid var(--border);
  }
  .hero__dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .hero__terminal-file {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--text-muted);
    margin-left: auto;
    letter-spacing: 0.02em;
  }
  .hero__terminal-body {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.875rem 1rem;
    overflow-x: auto;
  }
  .hero__prompt {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 500;
    flex-shrink: 0;
    user-select: none;
  }
  .hero__terminal-body code {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--code);
    white-space: nowrap;
    flex: 1;
  }
  .hero__copy {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    flex-shrink: 0;
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.1);
    color: var(--text-2);
    padding: 0.28rem 0.6rem;
    border-radius: 5px;
    cursor: pointer;
    font-size: 0.7rem;
    font-family: var(--font-body);
    font-weight: 500;
    transition: background 0.15s, color 0.15s, border-color 0.15s;
    white-space: nowrap;
  }
  .hero__copy:hover {
    background: rgba(255,255,255,0.11);
    border-color: rgba(255,255,255,0.18);
    color: var(--text);
  }
  .hero__copy--done {
    color: var(--code) !important;
    border-color: rgba(86, 216, 168, 0.3) !important;
  }

  /* Action buttons */
  .hero__actions {
    display: flex;
    gap: 0.625rem;
    flex-wrap: wrap;
    align-items: center;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.6rem 1.375rem;
    border-radius: 7px;
    font-weight: 500;
    font-size: 0.875rem;
    text-decoration: none;
    transition: all 0.15s;
    white-space: nowrap;
    font-family: var(--font-body);
    border: 1px solid transparent;
  }
  .btn--primary {
    background: var(--accent);
    color: #fff;
    box-shadow: 0 0 22px rgba(240, 130, 32, 0.28);
  }
  .btn--primary:hover {
    background: var(--accent-bright);
    box-shadow: 0 0 30px rgba(240, 130, 32, 0.42);
    transform: translateY(-1px);
  }
  .btn--secondary {
    background: rgba(255,255,255,0.06);
    border-color: var(--border);
    color: var(--text);
  }
  .btn--secondary:hover {
    background: rgba(255,255,255,0.09);
    border-color: var(--border-hover);
  }
  .btn--ghost {
    border-color: var(--border);
    color: var(--text-2);
  }
  .btn--ghost:hover {
    color: var(--text);
    border-color: var(--border-hover);
    background: rgba(255,255,255,0.04);
  }

  /* Screenshot */
  .hero__visual {
    flex-shrink: 0;
    position: relative;
  }
  .hero__screenshot-halo {
    position: absolute;
    inset: -40px;
    background: radial-gradient(ellipse at center, rgba(240, 130, 32, 0.11) 0%, transparent 68%);
    pointer-events: none;
  }
  .hero__screenshot {
    display: block;
    border-radius: 12px;
    max-width: 350px;
    width: 100%;
    position: relative;
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.07),
      0 0 0 1px rgba(240, 130, 32, 0.18),
      0 32px 80px rgba(0, 0, 0, 0.65);
  }

  @media (max-width: 900px) {
    .hero__inner { flex-direction: column; gap: 2.5rem; }
    .hero__visual { display: none; }
  }
  @media (max-width: 640px) {
    .hero { padding: 4rem 1.5rem 3.5rem; }
  }
</style>
