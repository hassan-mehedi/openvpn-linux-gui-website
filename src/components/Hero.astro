---
import { Image } from 'astro:assets';
import heroImg from '../assets/screenshots/01-profiles-empty.png';
---

<section class="hero">
  <div class="hero__content">
    <h1 class="hero__title">OpenVPN 3 Linux Client</h1>
    <p class="hero__tagline">
      A native GTK4 GUI and companion CLI for OpenVPN 3 Linux —
      full D-Bus integration, no vendor lock-in.
    </p>
    <div class="hero__install">
      <code id="install-cmd">curl -fsSL https://raw.githubusercontent.com/hassan-mehedi/openvpn-linux-client-gui/main/install.sh | bash</code>
      <button id="copy-btn" class="hero__copy" aria-label="Copy install command">Copy</button>
    </div>
    <div class="hero__actions">
      <a
        href="https://github.com/hassan-mehedi/openvpn-linux-client-gui/releases"
        class="btn btn--primary"
      >
        Download
      </a>
      <a
        href="https://github.com/hassan-mehedi/openvpn-linux-client-gui"
        class="btn btn--ghost"
        target="_blank"
        rel="noopener"
      >
        View on GitHub
      </a>
    </div>
  </div>
  <div class="hero__image">
    <Image
      src={heroImg}
      alt="OpenVPN 3 Linux Client – Profiles view"
      width={320}
      quality={90}
      class="hero__screenshot"
    />
  </div>
</section>

<script>
  const btn = document.getElementById('copy-btn');
  const cmd = document.getElementById('install-cmd');
  btn?.addEventListener('click', () => {
    navigator.clipboard.writeText(cmd?.textContent ?? '');
    btn.textContent = 'Copied!';
    setTimeout(() => { btn.textContent = 'Copy'; }, 2000);
  });
</script>

<style>
  .hero {
    background: #1B3A5C;
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 3rem;
    padding: 5rem 2rem;
    max-width: 1200px;
    margin: 0 auto;
  }
  .hero__content {
    flex: 1;
    max-width: 540px;
  }
  .hero__title {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700;
    line-height: 1.15;
    margin: 0 0 1rem;
  }
  .hero__tagline {
    font-size: 1.125rem;
    line-height: 1.6;
    color: rgba(255,255,255,0.82);
    margin: 0 0 2rem;
  }
  .hero__install {
    display: flex;
    align-items: center;
    background: rgba(0,0,0,0.3);
    border-radius: 8px;
    padding: 0.75rem 1rem;
    gap: 0.75rem;
    margin-bottom: 1.75rem;
    overflow-x: auto;
  }
  .hero__install code {
    font-family: 'Fira Code', 'Cascadia Code', monospace;
    font-size: 0.8rem;
    white-space: nowrap;
    color: #a8d8a8;
    flex: 1;
  }
  .hero__copy {
    background: rgba(255,255,255,0.15);
    border: none;
    color: white;
    padding: 0.3rem 0.75rem;
    border-radius: 4px;
    cursor: pointer;
    font-size: 0.8rem;
    white-space: nowrap;
    transition: background 0.15s;
  }
  .hero__copy:hover { background: rgba(255,255,255,0.25); }
  .hero__actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .btn {
    padding: 0.75rem 1.75rem;
    border-radius: 8px;
    font-weight: 600;
    font-size: 1rem;
    text-decoration: none;
    transition: opacity 0.15s, transform 0.15s;
  }
  .btn:hover { opacity: 0.88; transform: translateY(-1px); }
  .btn--primary {
    background: #F08220;
    color: #ffffff;
  }
  .btn--ghost {
    border: 2px solid rgba(255,255,255,0.6);
    color: #ffffff;
  }
  .hero__image {
    flex-shrink: 0;
  }
  .hero__screenshot {
    border-radius: 12px;
    box-shadow: 0 24px 64px rgba(0,0,0,0.5);
    max-width: 300px;
    width: 100%;
  }
  @media (max-width: 768px) {
    .hero {
      flex-direction: column;
      padding: 3rem 1.5rem;
    }
    .hero__image { display: none; }
  }
</style>
