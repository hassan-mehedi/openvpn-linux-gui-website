---
<header class="site-nav">
  <div class="site-nav__inner">
    <a href="/" class="site-nav__logo" aria-label="OpenVPN 3 Linux Client home">
      <img src="/icons/app.svg" alt="" width="26" height="26" class="site-nav__icon" />
      <span class="site-nav__name">OpenVPN 3 Linux</span>
    </a>
    <nav class="site-nav__links">
      <a href="/docs/getting-started/requirements/" class="site-nav__link">Docs</a>
      <a
        href="https://github.com/hassan-mehedi/openvpn-linux-client-gui"
        target="_blank"
        rel="noopener"
        class="site-nav__link site-nav__link--outlined"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
        </svg>
        GitHub
      </a>
    </nav>
  </div>
</header>

<style>
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(7, 17, 30, 0.82);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--border);
  }
  .site-nav__inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
    height: 3.75rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .site-nav__logo {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    text-decoration: none;
  }
  .site-nav__icon {
    border-radius: 6px;
    flex-shrink: 0;
  }
  .site-nav__name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--text);
    letter-spacing: -0.01em;
  }
  .site-nav__links {
    display: flex;
    align-items: center;
    gap: 0.375rem;
  }
  .site-nav__link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.375rem 0.875rem;
    border-radius: 6px;
    color: var(--text-2);
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 500;
    transition: color 0.15s, background 0.15s, border-color 0.15s;
  }
  .site-nav__link:hover {
    color: var(--text);
    background: rgba(255, 255, 255, 0.05);
  }
  .site-nav__link--outlined {
    border: 1px solid var(--border);
  }
  .site-nav__link--outlined:hover {
    border-color: var(--border-hover);
    background: rgba(255, 255, 255, 0.04);
  }
</style>
