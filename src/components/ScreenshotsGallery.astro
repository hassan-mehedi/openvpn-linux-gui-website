---
import { Image } from 'astro:assets';

import s01 from '../assets/screenshots/01-profiles-empty.png';
import s02 from '../assets/screenshots/02-import-profile-file.png';
import s03 from '../assets/screenshots/03-import-profile-form.png';
import s04 from '../assets/screenshots/04-connected.png';
import s05 from '../assets/screenshots/05-connection-stats.png';
import s06 from '../assets/screenshots/06-disconnect-confirm.png';
import s07 from '../assets/screenshots/07-profile-list.png';
import s08 from '../assets/screenshots/08-settings-connection.png';
import s09 from '../assets/screenshots/09-settings-presentation.png';
import s10 from '../assets/screenshots/10-add-proxy.png';
import s11 from '../assets/screenshots/11-profile-details-light.png';
import s12 from '../assets/screenshots/12-profile-details-dark.png';

const screenshots = [
  { src: s01, alt: 'Profiles view – empty state' },
  { src: s02, alt: 'Import profile – file upload' },
  { src: s03, alt: 'Import profile – review form' },
  { src: s04, alt: 'Active connection with stats' },
  { src: s05, alt: 'Connection stats and throughput graph' },
  { src: s06, alt: 'Disconnect confirmation dialog' },
  { src: s07, alt: 'Profile list – disconnected' },
  { src: s08, alt: 'Settings – connection defaults' },
  { src: s09, alt: 'Settings – presentation options' },
  { src: s10, alt: 'Add proxy dialog' },
  { src: s11, alt: 'Profile details – light mode' },
  { src: s12, alt: 'Profile details – dark mode' },
];
---

<section class="gallery">
  <div class="gallery__inner">
    <div class="gallery__header">
      <span class="section-label">Screenshots</span>
      <h2 class="section-title">See it in action</h2>
      <p class="section-desc">Real UI — no mockups. Click any screenshot for a full-size view.</p>
    </div>
    <div class="gallery__grid">
      {screenshots.map((s, i) => (
        <button
          class="gallery__thumb"
          data-index={i}
          aria-label={`View full size: ${s.alt}`}
        >
          <Image
            src={s.src}
            alt={s.alt}
            width={480}
            quality={90}
            densities={[1, 2]}
            class="gallery__img"
          />
          <span class="gallery__caption">{s.alt}</span>
        </button>
      ))}
    </div>
  </div>
</section>

<dialog id="gallery-dialog" class="gallery-dialog">
  <button id="gallery-dialog-close" class="gallery-dialog__close" aria-label="Close">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
      <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
    </svg>
  </button>
  <img id="gallery-dialog-img" src="" alt="" class="gallery-dialog__img" />
</dialog>

<script>
  const dialog = document.getElementById('gallery-dialog') as HTMLDialogElement;
  const dialogImg = document.getElementById('gallery-dialog-img') as HTMLImageElement;
  const closeBtn = document.getElementById('gallery-dialog-close');

  document.querySelectorAll<HTMLButtonElement>('.gallery__thumb').forEach(btn => {
    btn.addEventListener('click', () => {
      const img = btn.querySelector('img')!;
      dialogImg.src = img.src;
      dialogImg.alt = img.alt;
      dialog.showModal();
    });
  });

  closeBtn?.addEventListener('click', () => dialog.close());
  dialog.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close();
  });
</script>

<style>
  .gallery {
    padding: 6rem 2rem;
    border-bottom: 1px solid var(--border);
  }
  .gallery__inner {
    max-width: 1200px;
    margin: 0 auto;
  }
  .gallery__header {
    margin-bottom: 3rem;
    max-width: 540px;
  }
  .gallery__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.875rem;
  }
  .gallery__thumb {
    position: relative;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 0;
    cursor: pointer;
    overflow: hidden;
    transition: border-color 0.2s, transform 0.2s, box-shadow 0.2s;
  }
  .gallery__thumb:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4), 0 0 0 1px rgba(240, 130, 32, 0.15);
  }
  .gallery__img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 9px;
  }
  .gallery__caption {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    padding: 1.5rem 0.75rem 0.625rem;
    font-size: 0.72rem;
    color: rgba(255,255,255,0.9);
    background: linear-gradient(to top, rgba(0,0,0,0.75) 0%, transparent 100%);
    opacity: 0;
    transition: opacity 0.2s;
    text-align: left;
    border-radius: 0 0 9px 9px;
    pointer-events: none;
  }
  .gallery__thumb:hover .gallery__caption {
    opacity: 1;
  }

  /* Modal */
  .gallery-dialog {
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 0;
    background: var(--surface);
    max-width: 90vw;
    max-height: 92vh;
    overflow: hidden;
  }
  .gallery-dialog::backdrop {
    background: rgba(0, 0, 0, 0.82);
    backdrop-filter: blur(4px);
  }
  .gallery-dialog__img {
    display: block;
    max-width: 85vw;
    max-height: 88vh;
    object-fit: contain;
    border-radius: 13px;
  }
  .gallery-dialog__close {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    background: rgba(255,255,255,0.08);
    border: 1px solid rgba(255,255,255,0.12);
    color: var(--text-2);
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.15s, color 0.15s;
  }
  .gallery-dialog__close:hover {
    background: rgba(255,255,255,0.14);
    color: var(--text);
  }

  @media (max-width: 900px) {
    .gallery__grid { grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 640px) {
    .gallery { padding: 4rem 1.5rem; }
    .gallery__grid { grid-template-columns: repeat(2, 1fr); }
  }
</style>
