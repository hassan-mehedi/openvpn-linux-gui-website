---
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer__inner">
    <div class="footer__brand">
      <a href="/" class="footer__logo" aria-label="Home">
        <img src="/icons/app.svg" alt="" width="22" height="22" />
        <span>OpenVPN 3 Linux Client</span>
      </a>
      <p class="footer__copy">
        &copy; {year} Mehedi Hassan. Licensed under
        <a href="https://creativecommons.org/licenses/by-nc/4.0/" target="_blank" rel="noopener">
          CC BY-NC 4.0
        </a>.
      </p>
    </div>
    <nav class="footer__links" aria-label="Footer links">
      <a href="https://github.com/hassan-mehedi/openvpn-linux-client-gui" target="_blank" rel="noopener">GitHub</a>
      <a href="https://github.com/hassan-mehedi/openvpn-linux-client-gui/releases" target="_blank" rel="noopener">Releases</a>
      <a href="https://github.com/hassan-mehedi/openvpn-linux-client-gui/issues" target="_blank" rel="noopener">Issues</a>
      <a href="/docs/reference/known-limitations/">Known Limitations</a>
    </nav>
  </div>
</footer>

<style>
  .footer {
    padding: 2.5rem 2rem;
    border-top: 1px solid var(--border);
  }
  .footer__inner {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1.5rem;
  }
  .footer__brand {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .footer__logo {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--text-2);
    font-family: var(--font-display);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    transition: color 0.15s;
  }
  .footer__logo:hover { color: var(--text); }
  .footer__logo img { border-radius: 5px; }
  .footer__copy {
    margin: 0;
    font-size: 0.8rem;
    color: var(--text-muted);
  }
  .footer__copy a {
    color: var(--text-muted);
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color 0.15s;
  }
  .footer__copy a:hover { color: var(--accent); }
  .footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
  }
  .footer__links a {
    padding: 0.3rem 0.75rem;
    border-radius: 5px;
    color: var(--text-muted);
    font-size: 0.825rem;
    text-decoration: none;
    transition: color 0.15s, background 0.15s;
  }
  .footer__links a:hover {
    color: var(--text-2);
    background: rgba(255,255,255,0.04);
  }

  @media (max-width: 640px) {
    .footer__inner { flex-direction: column; align-items: flex-start; }
  }
</style>
